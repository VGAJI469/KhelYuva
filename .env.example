# ==============================================================
# KhelYuva Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ==============================================================

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# --- App Configuration ---
# Set this to your production domain after deployment
SITE_URL=https://your-domain.vercel.app

# --- Deployment Target Notes ---
# For Vercel: add these in Project Settings → Environment Variables
# For Netlify: add these in Site Settings → Build & Deploy → Environment Variables
# For Railway: add these in your service's Variables tab
# For GitHub Pages: use GitHub Actions Secrets (via workflow file)

# --- Security Note ---
# The SUPABASE_ANON_KEY is safe for client-side use.
# It is NOT a secret — Supabase Row Level Security (RLS) protects your data.
# However, do NOT expose your service_role key in client-side code.
